#version 430 core
layout(local_size_x=256) in;
#include "particle_common.glsl"
shared uint scan[256];
void prefix(uint value){
    uint lane=gl_LocalInvocationID.x;scan[lane]=value;barrier();
    for(uint offset=1u;offset<256u;offset*=2u){
        uint add=lane>=offset?scan[lane-offset]:0u;barrier();scan[lane]+=add;barrier();
    }
}
void main(){
    uint id=gl_GlobalInvocationID.x,lane=gl_LocalInvocationID.x,block=gl_WorkGroupID.x;
    if(operation==0){
        if(id<CELL_COUNT){cells[COUNT_BASE+id]=0u;cells[CURSOR_BASE+id]=0u;}
#if PHASE_GATING
        if(id<PHASE_TILE_COUNT)cells[PHASE_MASK_BASE+id]=0u;
#endif
        if(id==0u){cells[0]=0u;cells[1]++;}return;
    }
    if(operation==1){
        if(id<aliveCount){
            Grain p=readParticle(slots[N+id]);uint c=uint(cell(p.position.xy));
            atomicAdd(cells[COUNT_BASE+c],1u);
#if PHASE_GATING
            uint tile=((c/uint(W))/16u)*PHASE_TILE_COLUMNS+(c%uint(W))/16u;
            atomicOr(cells[PHASE_MASK_BASE+tile],liquid(p)?1u:2u);
#endif
        }
        return;
    }
    if(operation==2){
        uint count=id<CELL_COUNT?cells[COUNT_BASE+id]:0u;prefix(count);
        if(id<CELL_COUNT)cells[START_BASE+id]=scan[lane]-count;
        if(lane==255u)cells[BLOCK_BASE+block]=scan[lane];return;
    }
    if(operation==3){
        uint count=lane<240u?cells[BLOCK_BASE+lane]:0u;prefix(count);
        if(lane<240u)cells[BLOCK_OFFSET_BASE+lane]=scan[lane]-count;return;
    }
    if(operation==5||operation==7){
        if(id>=aliveCount)return;id=slots[N+id];if(operation==5&&id>=256u)return;
        Grain p=readParticle(id);uint candidates=0u,neighbors=0u;
        FOR_NEIGHBOR(p,2.0,j)
            ++candidates;
            if(uint(j)!=id){Grain q=readParticle(uint(j));vec2 d=separation(p,q);
                if(dot(d,d)<4){++neighbors;
                    if(operation==5&&j<256)terms[id*256u+uint(j)]=vec4(1,visible(p.position.xy,q.position.xy)?1:0,0,0);
                }
            }
        END_NEIGHBOR
        if(operation==7)terms[id]=vec4(candidates,neighbors,0,0);return;
    }
    if(operation==6){
        if(id>=aliveCount)return;id=slots[N+id];Grain p=readParticle(id);move(p,terms[id].xy);storeParticle(id,p);return;
    }
    if(operation==4){
        if(id>=aliveCount)return;uint stable=slots[N+id];Grain p=readParticle(stable);uint c=uint(cell(p.position.xy));
        uint index=cellStart(c)+atomicAdd(cells[CURSOR_BASE+c],1u);
        order[index]=stable;sortedIndex[stable]=index;anchors[stable]=vec4(p.position.xy,p.residual.xy);
#if HOT_READS == 2
        HotParticle value=HotParticle(vec4(p.position.xy,p.residual.xy),p.motion);
        hot[index]=value;hot[uint(N)+index]=value;
#endif
        atomicMax(cells[0],floatBitsToUint(length(p.residual.xy)));return;
    }
}
