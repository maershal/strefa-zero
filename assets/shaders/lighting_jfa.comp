#version 430 core
layout(local_size_x=8,local_size_y=8) in;
#include "lighting_common.glsl"
layout(rg16ui,binding=1) readonly uniform uimage2D sourceSeeds;
layout(rg16ui,binding=2) writeonly uniform uimage2D destinationSeeds;
uniform int jump;
void main(){ivec2 c=ivec2(gl_GlobalInvocationID.xy);if(any(greaterThanEqual(c,ivec2(320,192)))||lightCounts.z==0u)return;
uvec2 best=uvec2(65535u);float distance=1e20;for(int y=-1;y<=1;++y)for(int x=-1;x<=1;++x){ivec2 n=c+ivec2(x,y)*jump;if(any(lessThan(n,ivec2(0)))||any(greaterThanEqual(n,ivec2(320,192))))continue;
uvec2 s=imageLoad(sourceSeeds,n).rg;if(s.x==65535u)continue;vec2 d=vec2(c)-vec2(s);float q=dot(d,d);if(q<distance||(q==distance&&(s.y<best.y||(s.y==best.y&&s.x<best.x)))){best=s;distance=q;}}
imageStore(destinationSeeds,c,uvec4(best,0,0));}
