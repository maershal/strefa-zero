#version 430 core
layout(local_size_x=LOCAL_SIZE) in;
#include "particle_common.glsl"
#include "body_terrain.glsl"
uniform int bodyTestCount;
shared vec4 partial[LOCAL_SIZE];
void applyBody(vec4 sum){
    bodyLastSum=sum;bodyTotalSum+=sum;bodyStats.y++;
    if(dot(sum.xy,sum.xy)>1e-12){game.actor.xy+=sum.xy;terrainBody();}
    if(sum.z>0)game.locomotion.z=1;
    bodyQueue.x=0u;atomicExchange(slots[2*N+BODY_REDUCE_COMMAND],0u);atomicExchange(slots[2*N+BODY_FINAL_COMMAND],0u);
}
void main(){
    uint lane=gl_LocalInvocationID.x,id=gl_GlobalInvocationID.x;
    if(operation==2){
        if(id<uint(bodyTestCount))appendBodyEntry(id,terms[uint(N)+id]);return;
    }
    vec4 sum=vec4(0);
    uint count=min(bodyQueue.x,uint(2*N));
    if(operation==0){if(id<count)sum=terms[uint(N)+bodyIds[id]];}
    else {
        uint groups=(count+uint(LOCAL_SIZE)-1u)/uint(LOCAL_SIZE);
        for(uint k=lane;k<groups;k+=uint(LOCAL_SIZE))sum+=bodyPartial[k];
    }
    partial[lane]=sum;barrier();
    for(uint stride=uint(LOCAL_SIZE)/2u;stride>0u;stride/=2u){if(lane<stride)partial[lane]+=partial[lane+stride];barrier();}
    if(lane==0u){
        if(operation==0){
            if(gl_WorkGroupID.x==0u)bodyStats.z+=gl_NumWorkGroups.x;
            if(gl_NumWorkGroups.x==1u)applyBody(partial[0]);
            else bodyPartial[gl_WorkGroupID.x]=partial[0];
        }else {bodyStats.w++;applyBody(partial[0]);}
    }
}
