#version 430 core
layout(local_size_x=64) in;
#include "lighting_visibility.glsl"
layout(std430,binding=4) readonly buffer Rays {vec4 rays[];};
layout(std430,binding=5) writeonly buffer Answers {float answers[];};
uniform int probeCount;
void main(){uint i=gl_GlobalInvocationID.x;if(i>=uint(probeCount))return;answers[i]=lightVisible(rays[i].xy,rays[i].zw)?1.:0.;}
