bool solidCell(int i){return walls[i]!=0u;}
bool selected(vec2 p){vec2 d=brushSegment.zw-brushSegment.xy;float t=clamp(dot(p-brushSegment.xy,d)/max(dot(d,d),1e-9),0,1);return length(p-brushSegment.xy-t*d)<=brushRadius;}
int sourceCell(Grain p){return indexOf(clamp(ivec2(floor(p.position.xy)),ivec2(0),ivec2(TW-1,TH-1)));}
int physicalMaterial(float kind){int k=int(kind);return k==1?2:k==2?19:k==3?16:k==4?1:k==5?3:k==6?4:0;}
float cpMatter(vec4 m){return m.x*thermalProperties[int(m.w)].y;}
int receiver(int i){if(!solidCell(i))return i;ivec2 c=coordinate(i);for(int k=0;k<4;++k){ivec2 n=c+directions[k];if(validCell(n)&&!solidCell(indexOf(n)))return indexOf(n);}return i;}
float fuelRequest(vec4 m){int k=int(m.w);if(k!=4&&k!=5)return 0.;vec4 b=combustionProperties[k];return b.y>0&&matterTemperature(m)>=b.x?min(m.z,m.z*b.y*timeStep):0.;}
float oxygenRequest(vec4 m){return 2.*(1.-combustionProperties[int(m.w)].w)*fuelRequest(m);}
float cellOxygenRequest(int i){ThermalCell c=grid[i];float own=gasTemperature(c)>=combustionProperties[11].x?min(c.gas1.x,c.gas1.x*combustionProperties[11].y*timeStep)*2.:0.;ivec2 p=coordinate(i);own+=receiver(i)==i?oxygenRequest(c.matter):0.;for(int k=0;k<4;++k){ivec2 n=p+directions[k];if(validCell(n)){int j=indexOf(n);if(receiver(j)==i)own+=oxygenRequest(grid[j].matter);}}for(int p=heads[i];p>=0;p=links[p])own+=tp[p].request.w;return own;}
float availableGas(ThermalCell c){return max(0,c.gas1.z-gasOffset(c)-gasCapacity(c));}
// Two positive reductions can each accumulate <=32768 floats. Reserve 0.5%
// when a shared donor is exhausted, exceeding their worst-case rounding bound.
float budgetScale(float demand,float available){return demand>0?min(1.,.995*available/demand):1.;}
float conduction(float ta,float ca,float ka,float aa,float tb,float cb,float kb,float ab){if(ca<=0||cb<=0)return 0.;float q=(tb-ta)*min(timeStep*min(ka,kb),.08*min(ca,cb));return clamp(q,-aa*.1,ab*.1);}
float matterAvailable(vec4 m){return max(0,m.y-minimumH(m));}
float materialConductance(vec4 m){return m.x>0?thermalProperties[int(m.w)].z:0.;}
float pressureAt(int i){return pressureBank==0?uintBitsToFloat(pa[i]):pb[i];}
float face(int i,int k){ivec2 n=coordinate(i)+directions[k];if(!validCell(n)||solidCell(i)||solidCell(indexOf(n)))return 0.;int j=indexOf(n);return k==0?-grid[j].flow.x:k==1?grid[i].flow.x:k==2?-grid[j].flow.y:grid[i].flow.y;}
float outgoing(int i){float sum=0;for(int k=0;k<4;++k)sum+=max(0,face(i,k));return timeStep*sum;}
float donorScale(int i){return min(1.,.45/max(outgoing(i),1e-12));}
float species(ThermalCell c,int s){return s<4?c.gas0[s]:c.gas1[s-4];}
