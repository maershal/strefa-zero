#version 430 core
layout(local_size_x=128) in;
#include "particle_storage.glsl"
#include "thermal_common.glsl"
layout(std430,binding=2) buffer ThermalParticles {ThermalParticle particles[];};
layout(std430,binding=3) buffer ThermalCells {ThermalCell cells[];};
layout(std430,binding=4) readonly buffer Terrain {uint walls[];};
layout(std430,binding=5) readonly buffer FreeSlots {uint slots[];};
layout(std430,binding=6) buffer Counts {uvec4 count0;uvec4 count1;};
void main(){uint i=gl_GlobalInvocationID.x;if(i>=uint(TC)||walls[i]!=0u)return;ThermalCell c=cells[i];if(!waterFamily(int(c.matter.w))||c.matter.x<.001)return;vec3 ph=phase(int(c.matter.w),c.matter.y/c.matter.x);if(ph.y<.5)return;uint ticket=atomicAdd(count0.y,1u);if(ticket>=count0.x)return;uint slot=slots[ticket];float mass=min(c.matter.x,32.),e=mass*(c.matter.y/c.matter.x);vec2 center=vec2(coordinate(int(i)))+.5;Grain p;p.position=vec4(center,center);p.motion=vec4(0,0,1./mass,5);p.contact=vec4(0,0,center);p.residual=vec4(0);writeParticle(slot,p);ThermalParticle a;a.matter=vec4(mass,e,0,3);a.request=a.transfer=vec4(0);a.history=vec4(5,mass,ph.x,ph.y);particles[slot]=a;c.matter.xy-=vec2(mass,e);if(c.matter.x<1e-8)c.matter=vec4(0);cells[i]=c;atomicAdd(count0.z,1u);atomicAdd(count0.w,1u);}
