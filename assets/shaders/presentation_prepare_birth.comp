#version 430 core
layout(local_size_x=128) in;
#define PARTICLE_RENDER 1
#include "particle_storage.glsl"
#include "presentation_birth.glsl"
layout(std430,binding=5) readonly buffer Slots {uint slots[];};
uniform int mode;
// Allocators only take inactive slots. Clear their presentation history before
// allocation, keeping every numerical solver shader byte-identical to I10.
void main(){uint id=gl_GlobalInvocationID.x;if(id>=32768u)return;if(mode!=0&&slots[65536u+22u]==0u)return;if(readParticle(id).motion.w<.5)presentationBirth(id);}
