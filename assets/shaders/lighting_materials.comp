#version 430 core
layout(local_size_x=64) in;
#include "lighting_common.glsl"
layout(std430,binding=2) writeonly buffer MaterialSources {PointLight candidates[960];};
layout(binding=1) uniform sampler2D heatField;
layout(binding=3) uniform usampler2D terrainMap;
void main(){uint id=gl_GlobalInvocationID.x;if(id>=960u)return;int x=int(id%40u)*8,y=int(id/40u)*8;float peak=0.;vec2 pos=vec2(0);vec3 rgb=vec3(0);
 for(int dy=0;dy<8;++dy)for(int dx=0;dx<8;++dx){ivec2 c=ivec2(x+dx,y+dy);vec4 h=texelFetch(heatField,c,0);float e=h.g;
  if(e<=peak)continue;ivec2 freeCell=c;bool found=texelFetch(terrainMap,c,0).r==0u;
  for(int side=0;side<4&&!found;++side){ivec2 d=side==0?ivec2(0,-1):side==1?ivec2(1,0):side==2?ivec2(-1,0):ivec2(0,1);ivec2 n=c+d;
   if(all(greaterThanEqual(n,ivec2(0)))&&all(lessThan(n,ivec2(320,192)))&&texelFetch(terrainMap,n,0).r==0u){freeCell=n;found=true;}}
  if(found){peak=e;pos=vec2(freeCell)+.5;rgb=vec3(1.,.24,.025)*e;}}
 candidates[id]=PointLight(vec4(pos,peak>.01?clamp(10.+peak*5.,10.,38.):0.,1),vec4(rgb,1),vec4(0,1.+min(peak,.99),0,float(id)));
}
