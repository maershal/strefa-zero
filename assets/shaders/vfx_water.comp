    vec2 normal=-gradient/g,mean=(left.zw*left.x+right.zw*right.x+up.zw*up.x+down.zw*down.x)/max(left.x+right.x+up.x+down.x,1e-6);float relative=length(f.zw-mean),curvature=max(0,4*d-left.x-right.x-up.x-down.x);
    float crest=clamp(dot(f.zw,normal)/30.,0,1)*clamp(curvature,0,1),air=clamp(relative/35.,0,1);float energy=clamp(relative*relative/900.,0,1);
    float rate=energy*(crest*5+air*8)*(quality==2?1.:.35);uint seed=hashVfx(id^hashVfx(uint(sourceTick))^uint(sourceGeneration));
