#version 430 core
layout(local_size_x=128) in;
#include "thermal_common.glsl"
layout(std430,binding=5) readonly buffer ThermalCells {ThermalCell cells[];};
layout(rgba16f,binding=0) writeonly uniform image2D heatImage;
void main(){uint i=gl_GlobalInvocationID.x;if(i>=61440u)return;ThermalCell c=cells[i];float t=max(gasTemperature(c),c.matter.x>0.?matterTemperature(c.matter):293.15);t=max(t,c.extra.z);
float glow=clamp(c.extra.x*8.,0.,5.);if((int(c.matter.w)==10&&c.matter.x>0.)||int(c.extra.w)==10)glow=max(glow,clamp((t-1000.)/400.,0.,4.));imageStore(heatImage,coordinate(int(i)),vec4(min(t,60000.),glow,0,0));}
