{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(/docs/measurements/**)",
      "Read(./docs/measurements/**)",
      "Read(/docs/**/*.bmp)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/block-measurements.sh\""
          }
        ]
      }
    ]
  }
}
